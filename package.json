{
  "name": "dsa-desk",
  "productName": "DSA Desk",
  "version": "0.1.0",
  "description": "A cozy desktop study companion: problem of the day, what to try next, and progress across LeetCode, Codeforces, GeeksforGeeks and AtCoder.",
  "main": "./out/main/index.js",
  "author": "projectu20250727@gmail.com",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "guide": "python scripts/extract-guide.py",
    "smoke:sync": "node -e \"process.env.SMOKE=1;require('child_process').execSync('npx vitest run',{stdio:'inherit',env:process.env})\"",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.dsadesk.app",
    "productName": "DSA Desk",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DSA Desk"
    },
    "npmRebuild": true
  }
}
